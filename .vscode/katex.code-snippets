	// }

	"katex-inline": {
		"scope": "markdown",
		"prefix": "\\$",
		"body": [
			"$$1$$0"
		],
		"description": "Insert KaTeX inline"
	},
	"katex-block": {
		"scope": "markdown",
		"prefix": "\\$$",
		"body": [
			"$$",
			"$1",
			"$$",
			"$0"
		],
		"description": "Insert KaTeX block"
	},
	"cases": {
		"scope": "markdown",
		"prefix": "\\cases",
		"body": [
			"\\begin{cases}",
			"$1 & \\text{if } $2 \\\\",
			"$3 & \\text{if } $4",
			"\\end{cases}$0"
		],
		"description": "Insert cases environment"
	},
	"align": {
		"scope": "markdown",
		"prefix": "\\align",
		"body": [
			"\\begin{align}",
			"$1 \\\\",
			"$2",
			"\\end{align}$0"
		],
		"description": "Insert align environment"
	}
}